# Copy this file to server/.env (that file is git-ignored) and fill in your key.
# Get a key at https://platform.claude.com/ -> API keys.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# MODEL=claude-haiku-5-5
# DAILY_CALL_CAP=300
# PER_IP_DAILY_CAP=40
# PORT=8787
# Comma-separated sites allowed to call this server (localhost is always allowed)
# ALLOWED_ORIGINS=https://codypoirier2002-ui.github.io
# Set when running behind a reverse proxy so per-visitor limits use the real IP
# TRUST_PROXY=1
